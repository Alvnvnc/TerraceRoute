# Copy to .env and fill in. Use a TEST zone, never production.
# Token scope (least privilege): Account -> Cloudflare Tunnel: Edit,
#                                Zone -> DNS: Edit (scoped to this one zone).
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_TOKEN=

# Local cloudflared metrics server (default first free port is 20241-20245).
CF_METRICS_ADDR=127.0.0.1:20241

# Audit journal location.
TG_JOURNAL=artifacts/journal.jsonl
