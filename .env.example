# ---- Local (Ollama) ----
OLLAMA_HOST=http://localhost:11434
# Dev di PC kuat: qwen2.5:14b-instruct. Submission portable/CPU: qwen2.5:3b-instruct-q4_K_M
LOCAL_MODEL=qwen2.5:14b-instruct
EMBED_MODEL=bge-m3
# Ollama < 0.12.11 tidak expose logprobs -> set false, router pakai self-consistency
OLLAMA_LOGPROBS=true

# ---- Remote (Fireworks AI) ----
FIREWORKS_API_KEY=changeme
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Model remote diumumkan saat kickoff; ganti sesuai yang diizinkan
REMOTE_MODEL=accounts/fireworks/models/qwen2p5-72b-instruct

# ---- Router thresholds (di-tune oleh eval/run_eval.py) ----
TAU1=0.35          # < TAU1 -> LOCAL_ONLY
TAU2=0.65          # [TAU1,TAU2) -> draft+patch ; >= TAU2 -> remote full
ACCURACY_FLOOR=0.80
SELF_CONSISTENCY_K=3

# ---- Cache (opsional) ----
CACHE_ENABLED=true
CACHE_SIM_THRESHOLD=0.95

# ---- Artefak kalibrasi ----
CALIBRATOR_PATH=artifacts/calibrator.json
