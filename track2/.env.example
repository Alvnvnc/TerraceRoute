# Runtime-only credentials and model IDs. Do not copy this file into the image.
# The Fireworks key may be the same key used by Track 1.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Must be an image-capable Gemma ON-DEMAND deployment ID, not a base model ID.
# FIREWORKS_GEMMA_MODEL=accounts/<account>/deployments/<deployment>

# Optional generic fallbacks. The checker must use a different model from the generator.
FB_BASE_URL=
FB_API_KEY=
FB_MODEL=
FB_CHECKER_MODEL=
