# Example env for local development of the batch agent.
# Do NOT bundle a .env into the submission image — the harness injects
# FIREWORKS_* and ALLOWED_MODELS at scoring time.

# I/O (defaults are /input/tasks.json and /output/results.json)
INPUT_PATH=eval/practice_tasks.json
OUTPUT_PATH=/tmp/results.json

# Local model
LOCAL_BACKEND=ollama            # ollama (dev) | llamacpp (in-image prod)
LOCAL_MODEL=qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434

# Escalation policy (0..4): 0 zero-API | 1 verify-fail/empty | 2 +math&factual
# | 3 +sentiment&logical | 4 all unverifiable. See docs/escalation-math.md.
ESCALATION_LEVEL=0
REMOTE_CONCURRENCY=4

# Remote (for testing escalation; injected by the harness at scoring time)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ALLOWED_MODELS=

# Time budget (10-minute total rule)
WATCHDOG_S=510
LOCAL_MAX_TOKENS=512
