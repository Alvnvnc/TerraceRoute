# Copy to `.streamlit/secrets.toml` (gitignored) for local runs, OR paste these into
# the Streamlit Cloud "Secrets" box, OR pass them as `-e` env vars to `docker run`.
# NEVER commit real secrets — they are read at runtime and never baked into the image.

# Required: your Fireworks API key.
FIREWORKS_API_KEY = "fw_XXXXXXXXXXXXXXXXXXXX"

# Optional (sensible public defaults are used if omitted):
FIREWORKS_BASE_URL = "https://api.fireworks.ai/inference/v1"
ALLOWED_MODELS = "accounts/fireworks/models/llama-v3p1-8b-instruct"
