# Contoh env untuk dev lokal agent batch (JANGAN bundle .env ke image submission —
# harness menginjeksi FIREWORKS_* & ALLOWED_MODELS saat scoring).

# I/O (default sudah /input/tasks.json & /output/results.json)
INPUT_PATH=eval/practice_tasks.json
OUTPUT_PATH=/tmp/results.json

# Model lokal
LOCAL_BACKEND=ollama            # ollama (dev) | llamacpp (prod in-image)
LOCAL_MODEL=qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434

# Kebijakan eskalasi: 0 zero-API | 1 verify-fail | 2 +trap | 3 agresif
ESCALATION_LEVEL=0

# Remote (untuk uji escalation; saat scoring diinjeksi harness)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ALLOWED_MODELS=

# Anggaran waktu (aturan total 10 menit)
WATCHDOG_S=510
LOCAL_MAX_TOKENS=512
